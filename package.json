{
  "name": "lumen",
  "productName": "Lumen",
  "version": "1.0.0",
  "description": "A local-first Markdown editor with Typora-style live preview",
  "author": {
    "name": "zzulee",
    "email": "11265206+zzulee@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzulee/lumen.git"
  },
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "build:watch": "node build.js --watch",
    "start": "node build.js && electron .",
    "verify": "node build.js && electron .",
    "dist": "node build.js && electron-builder --win --x64",
    "dist:dir": "node build.js && electron-builder --win --x64 --dir",
    "release": "node build.js && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.zzulee.lumen",
    "productName": "Lumen",
    "copyright": "Copyright © 2026 zzulee",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/shared/**/*",
      "src/renderer/index.html",
      "src/renderer/styles.css",
      "src/renderer/bundle.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "msi",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumen",
      "artifactName": "Lumen-Setup-${version}.${ext}"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "artifactName": "Lumen-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Lumen-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-python": "^6.1.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.3.0",
    "marked": "^14.0.0"
  }
}
